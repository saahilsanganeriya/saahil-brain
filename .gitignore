# The brain's DATA never enters this repo (customer data / PII lives in ~/brain only).
/brain/
*.db
*.db-*
*.sqlite*
*.jsonl
*.jsonl.zst
*.parquet
.index/
.data/
.archive/
transcripts/
sessions/
# build outputs
/bin/
/dist/
# team profiles stay out of git; the build still puts them into the binary (profiles/profiles.go)
/profiles/*.json
!/profiles/example.json
# some machines ignore docs/ globally; this repo ships its docs/ folders
!docs/
