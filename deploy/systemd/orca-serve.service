# Orca runtime server on the devbox: owns worktrees, agent terminals and orchestration state, so agents keep
# coordinating while the laptop sleeps. Port 6768 is closed by the EC2 security group; the laptop reaches it
# through an SSH forward (laptop 127.0.0.1:16768 -> devbox 127.0.0.1:6768), the address advertised below.
[Unit]
Description=Orca runtime server (headless)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@LAPTOP_HOME@
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=PATH=@DEVBOX_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/orca/orca-linux.AppImage serve --port 6768 --pairing-address 127.0.0.1:16768 --json
StandardOutput=journal
StandardError=journal
KillMode=mixed
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5

[Install]
WantedBy=default.target
